# Supabase PostgreSQL / encryption
DATABASE_URL=
APP_ENCRYPTION_KEY=

# Render worker / queue
RENDER_WORKER_URL=
WORKER_API_TOKEN=
REDIS_URL=
RENDER_CONCURRENCY=1

# Cloudflare R2 (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=
