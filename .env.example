# Gemini - server-side only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI thumbnails - server-side only
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=

# YouTube OAuth
YOUTUBE_WORKSPACE_ID=default
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
