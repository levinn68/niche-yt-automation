# App
# Recommended in production; callback falls back to the incoming request origin.
APP_URL=http://localhost:3000
STUDIO_PASSWORD=
STUDIO_SESSION_SECRET=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# Gemini
GEMINI_API_KEY=

# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# PostgreSQL / token encryption
DATABASE_URL=
APP_ENCRYPTION_KEY=

# Render worker / queue
RENDER_WORKER_URL=
WORKER_API_TOKEN=
REDIS_URL=

# Cloudflare R2 (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional overrides (defaults are used when omitted)
# YOUTUBE_WORKSPACE_ID=default
# GEMINI_MODEL=gemini-2.5-flash
# RENDER_CONCURRENCY=1
